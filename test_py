import pandas as pd
import os
from sdv.datasets.demo import download_demo
from sdv.single_table import GaussianCopulaSynthesizer

print("🤖 Loading SDV demonstration data...")
# 1. Download a sample single-table dataset (flight bookings data)
real_data, metadata = download_demo(
    modality='single_table',
    dataset_name='fake_hotel_guests'
)

print("\n📊 Real Data Sample:")
print(real_data.head(3))

print("\n🏗️ Training the Gaussian Copula Synthesizer model...")
# 2. Initialize and fit the synthesizer to learn data distributions and types
synthesizer = GaussianCopulaSynthesizer(metadata)
synthesizer.fit(real_data)

print("\n✨ Generating synthetic data...")
# 3. Sample a completely new, private dataframe based on the learned patterns
synthetic_data = synthesizer.sample(num_rows=5)

print("\n🚀 Generated Synthetic Data Result:")
print(synthetic_data)

# 4. Save synthetic data to CSV on Desktop
desktop_path = os.path.expanduser("~\\Desktop")
csv_file_path = os.path.join(desktop_path, "synthetic_data.csv")
synthetic_data.to_csv(csv_file_path, index=False)

print(f"\n💾 Synthetic data saved to: {csv_file_path}")
print("\n✅ SDV test script completed successfully!")



